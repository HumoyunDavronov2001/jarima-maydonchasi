<?xml version="1.0" encoding="utf-8"?>
<!-- Terminal maydonchaning ichki tarmog'ida, HTTP orqali ishlaydi.
     Ma'lumot internetga chiqmaydi (TALABLAR T-2, Sy-1a). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
